# ===== ĐI TÙ ONLINE – cấu hình môi trường =====
# Chép file này thành .env rồi sửa.

# Chế độ: test = chỉ dữ liệu giả (chưa live) | live = kết nối TikTok thật
MODE=test

# Username TikTok của kênh đang LIVE (không cần @)
TIKTOK_USERNAME=

# Cổng và địa chỉ web. 127.0.0.1 = chỉ máy này truy cập được (an toàn nhất)
PORT=3000
HOST=127.0.0.1

# Bot demo tự sinh bình luận/quà giả (mặc định bật ở chế độ test). true/false
DEMO_BOT=

# (Tuỳ chọn) API key Euler Stream – giúp kết nối TikTok ổn định hơn, tránh bị giới hạn
EULER_API_KEY=

# (Tuỳ chọn) Mật khẩu để mở trang điều khiển từ máy khác: http://IP:3000/control?token=...
CONTROL_TOKEN=

# Log
LOG_DIR=logs
LOG_LEVEL=info

# Thời gian chờ kết nối lại TikTok (giây), tăng dần từ MIN tới MAX
RECONNECT_MIN_SECONDS=5
RECONNECT_MAX_SECONDS=120
