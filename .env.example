# ===== ĐI TÙ ONLINE 3D – cấu hình môi trường =====
# Chép thành .env rồi sửa.

# Mật khẩu trang /admin (BẮT BUỘC đặt khi đưa lên mạng)
ADMIN_PASSWORD=doi-mat-khau-nay

# Username TikTok của kênh đang LIVE (không cần @). Để trống = chưa kết nối TikTok.
TIKTOK_USERNAME=
# Tự kết nối TikTok khi khởi động
TIKTOK_AUTO_CONNECT=true
# Phòng nhận sự kiện TikTok (mặc định theo config.json → rooms.liveRoom)
LIVE_ROOM=

# (Tuỳ chọn) API key Euler Stream – kết nối TikTok ổn định hơn
EULER_API_KEY=

# Bot demo sinh bình luận/quà TikTok giả để thử trang /live
DEMO_BOT=false

# Web server
PORT=3000
HOST=0.0.0.0
# Đặt true khi chạy sau Caddy/Nginx để lấy đúng IP người chơi (dùng cho chặn)
TRUST_PROXY=false

# Tên miền khi deploy bằng docker compose (Caddy tự cấp HTTPS)
DOMAIN=ditu.example.com

# Log & dữ liệu
LOG_DIR=logs
LOG_LEVEL=info
DATA_DIR=data
RECONNECT_MIN_SECONDS=5
RECONNECT_MAX_SECONDS=120
